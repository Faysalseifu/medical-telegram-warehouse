# Telegram API credentials (https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here
PHONE_NUMBER=+10000000000

# Postgres connection used by loaders and API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medical_warehouse

# dbt profile variables (medical_warehouse/profiles.yml)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_PORT=5432
DB_NAME=postgres
DB_SSLMODE=require

# FastAPI configuration
# API_HOST=0.0.0.0
# API_PORT=8000
